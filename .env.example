# Database
DATABASE_URL=postgresql://p7erp:p7erp@localhost:5432/p7erp
# Optional SQLAlchemy pool tuning (async engine; see backend/app/database.py)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# First-user bootstrap (tenant has zero users): use one of:
# - BOOTSTRAP_REGISTRATION_KEY — same value in X-Bootstrap-Key header or signup "Invitation code" (shared across tenants)
# - Per-tenant: set tenants.bootstrap_token_hash to bcrypt hash of a one-time secret (see docs/PRE_PRODUCTION_AUDIT.md Finding #4); cleared after first admin registers
# In production (APP_ENV not dev/local/test), you must set one of the above unless you intentionally use dev-only frictionless sign-up.
# BOOTSTRAP_REGISTRATION_KEY=

# Tenant: subdomain | header | path
TENANT_STRATEGY=header

# CORS (comma-separated origins, or leave empty to allow same-origin only)
# Production reminder: set CORS_ORIGINS to your live https:// domain(s).
CORS_ORIGINS=

# Frontend API URL reminder: in production, set VITE_API_BASE_URL to your live https:// API domain.
# Example: VITE_API_BASE_URL=https://api.prime7erp.com
#
# Frontend host allowlist for Vite (comma-separated, no spaces).
# Production reminder: set this to your live frontend domain(s).
# Example: VITE_ALLOWED_HOSTS=prime7erp.com,www.prime7erp.com
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (optional, for sessions/cache)
REDIS_URL=redis://localhost:6379/0
# Per-tenant API cap (Redis). All /api/v1 routes with X-Tenant-Id count except GET /auth/me. 0 = disable.
# TENANT_RATE_LIMIT_REQUESTS_PER_MINUTE=2000

# App
API_V1_PREFIX=/api/v1

# Production planning AI (Gemini — cheapest Flash-lite; set GEMINI_API_KEY to enable)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_ENABLED=true
# Optional: cap total Gemini calls per calendar month (0 = unlimited). Used by ai_tool + shared helpers.
# AI_MONTHLY_BUDGET_LIMIT=0

# Docker Compose: copy this file to `.env` in the repo root (same folder as docker-compose.yml) so
# `GEMINI_API_KEY` is injected into the backend container. backend/.env is only used when running
# uvicorn locally outside Docker.

# Load testing (docker compose -f docker-compose.yml -f docker-compose.loadtest.yml)
# Set these to a real tenant company_code and user credentials, or Locust login will fail.
# LOADTEST_COMPANY_CODE=DEMO
# LOADTEST_USERNAME=admin
# LOADTEST_PASSWORD=admin123
# Optional: multiple users (JSON array). Overrides username/password above.
# LOADTEST_USERS_JSON=[{"username":"admin","password":"secret"},{"username":"user2","password":"x"}]
# Employee id used by Locust for POST /hr/attendance/entries (must exist for your tenant).
# LOADTEST_EMPLOYEE_ID=1
