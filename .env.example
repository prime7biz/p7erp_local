# Database
DATABASE_URL=postgresql://p7erp:p7erp@localhost:5432/p7erp
# Optional SQLAlchemy pool tuning (async engine; see backend/app/database.py). Pool is PER PROCESS:
# (uvicorn workers + Celery children) x (pool + overflow) must stay below PG_MAX_CONNECTIONS.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# Celery worker pool per child process (docker-compose.prod.yml worker service)
# CELERY_DB_POOL_SIZE=2
# CELERY_DB_MAX_OVERFLOW=3

# Production Postgres tuning (docker-compose.prod.yml; changing needs a Postgres restart)
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=128MB
# PG_MAX_CONNECTIONS=100
# PG_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=0
# PG_RANDOM_PAGE_COST=1.1
# PG_SHM_SIZE=256mb

# Celery (docker-compose.prod.yml worker)
# CELERY_CONCURRENCY=2
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# CELERY_WORKER_MAX_TASKS_PER_CHILD=200
# CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
# CELERY_TASK_TIME_LIMIT_SECONDS=3600

# Background schedulers: true = run inside API process; false = Celery beat (see docs/DEPLOYMENT_PROCESS.md)
# INPROCESS_SCHEDULERS_ENABLED=true

# Backend/worker/beat containers run as the unprivileged "app" user (uid/gid 10001).
# Defaults: true in docker-compose.prod.yml, false in docker-compose.yml (dev bind mount).
# The entrypoint fixes ownership of old root-owned media files on start. false = run as root (rollback switch).
# RUN_AS_NON_ROOT=true
# Merch alert_scan_log retention in days (0 = keep forever) and delete batch size
# ALERT_SCAN_LOG_RETENTION_DAYS=30
# ALERT_SCAN_LOG_PURGE_BATCH_SIZE=5000

# API / DB performance observability (defaults off; see docs/PERF_ROLLBACK_RUNBOOK.md)
# PERF_TIMING_ENABLED=false
# PERF_TIMING_SLOW_MS=750
# PERF_POOL_METRICS_ENABLED=false
# PERF_REQUEST_QUERY_WARN_BYTES=8192
# Set once per DB connection (or SET LOCAL per request when USE_PGBOUNCER=true). Applies to background jobs too.
# PERF_SESSION_STATEMENT_TIMEOUT_MS=0
# PERF_SESSION_LOCK_TIMEOUT_MS=0
# Recommended for scaling baseline (local/staging): log requests slower than 500ms.
# PERF_TIMING_ENABLED=true
# PERF_TIMING_SLOW_MS=500

# Optional PgBouncer (local/staging). When true, backend uses DATABASE_URL_PGBOUNCER instead of DATABASE_URL.
# USE_PGBOUNCER=false
# DATABASE_URL_PGBOUNCER=postgresql://p7erp:p7erp@pgbouncer:6432/p7erp

# Async background jobs (Celery). Off by default for safe rollout.
# PLATFORM_BULK_TENANT_ASYNC_ENABLED=false
# DATA_MIGRATION_ASYNC_ENABLED=false
# API response cache (Redis). Off by default.
# API_CACHE_ENABLED=false

# Subscription plan enforcement: block new users when plan max_users reached (default off).
# PLAN_ENFORCEMENT_ENABLED=false

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Frontend base URL used in password reset emails.
FRONTEND_URL=https://prime7erp.com
# SMTP mail provider (Postmark SMTP example)
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=no-reply@prime7erp.com
# EMAILS_FROM_NAME=Prime7 ERP
# First-user bootstrap (tenant has zero users): use one of:
# - BOOTSTRAP_REGISTRATION_KEY — same value in X-Bootstrap-Key header or signup "Invitation code" (shared across tenants)
# - Per-tenant: set tenants.bootstrap_token_hash to bcrypt hash of a one-time secret (see docs/PRE_PRODUCTION_AUDIT.md Finding #4); cleared after first admin registers
# In production (APP_ENV not dev/local/test), you must set one of the above unless you intentionally use dev-only frictionless sign-up.
# Public sign-up (POST /tenants) now stores a one-time per-tenant bootstrap token and returns it to the sign-up page,
# so self-service sign-up works without sharing BOOTSTRAP_REGISTRATION_KEY.
# BOOTSTRAP_REGISTRATION_KEY=
# false = company sign-up only with X-Bootstrap-Key=BOOTSTRAP_REGISTRATION_KEY or a platform-admin token (default true).
# PUBLIC_TENANT_SIGNUP_ENABLED=true
# Sign-ups allowed per client IP per hour (0 = no limit).
# TENANT_SIGNUP_RATE_LIMIT_PER_HOUR=10
#
# Outside development JWT_SECRET and AI_CONFIRMATION_TOKEN_PEPPER must be at least SECRET_MIN_LENGTH characters
# (default 32) or the API refuses to start. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_MIN_LENGTH=32
#
# Staff login lockout: after STAFF_LOGIN_MAX_ATTEMPTS failures from one IP that IP is blocked for that account for
# STAFF_LOGIN_LOCKOUT_MINUTES; the whole account locks only after STAFF_LOGIN_ACCOUNT_LOCK_THRESHOLD failures (0 = never).
# STAFF_LOGIN_MAX_ATTEMPTS=8
# STAFF_LOGIN_LOCKOUT_MINUTES=30
# STAFF_LOGIN_ACCOUNT_LOCK_THRESHOLD=40
#
# With single-session on, tokens without the session-version claim are refused. Optional grace end (UTC ISO):
# LEGACY_TOKEN_WITHOUT_SV_GRACE_UNTIL=
#
# Platform admin two-factor (TOTP). true = admins without an authenticator can only enrol until they set one up.
# PLATFORM_ADMIN_MFA_REQUIRED=false
# PLATFORM_ADMIN_MFA_ISSUER=Prime7 ERP
#
# Module permissions for tenants without their own rbac_enforcement flag: off | shadow (log only) | enforce.
# RBAC_DEFAULT_MODE=off

# Tenant: subdomain | header | path
TENANT_STRATEGY=header

# CORS (comma-separated origins, or leave empty to allow same-origin only)
# Production reminder: set CORS_ORIGINS to your live https:// domain(s).
# Never use "*": the backend then turns off credentialed CORS (cookies) for every origin.
CORS_ORIGINS=

# Customer / financier / supplier portal: keep the refresh token in an HttpOnly cookie instead of
# browser storage. Rollout: deploy with false -> set true -> next release drops body refresh tokens.
# See docs/FRONTEND_SECURITY_HEADERS.md ("Login tokens and the HttpOnly refresh cookie").
# AUTH_REFRESH_COOKIE_ENABLED=false
# Secure cookies are only sent over HTTPS (browsers also allow them on http://localhost).
# AUTH_COOKIE_SECURE=true
# strict | lax | none. strict needs the frontend and API on the same site (prime7erp.com).
# AUTH_COOKIE_SAMESITE=strict
# Empty = cookie only for the API host (recommended). Example for a split API host: .prime7erp.com
# AUTH_COOKIE_DOMAIN=

# Frontend API base URL (Vite injects at build time). Leave unset or empty so the browser calls
# same-origin /api/* (Docker nginx on 5173/5174 proxies to backend; `npm run dev` uses Vite proxy).
# Set only for split-host deployments, e.g. VITE_API_BASE_URL=https://api.prime7erp.com
#VITE_API_BASE_URL=
#
# Production image tags for `docker-compose.prod.yml` (Docker Hub).
# Example branch build:
# BACKEND_IMAGE=your-dockerhub-user/p7erp-backend:main
# FRONTEND_IMAGE=your-dockerhub-user/p7erp-frontend:main
# Example release tag build:
# BACKEND_IMAGE=your-dockerhub-user/p7erp-backend:v1.0.0
# FRONTEND_IMAGE=your-dockerhub-user/p7erp-frontend:v1.0.0
#
# Frontend host allowlist for Vite (comma-separated, no spaces).
# Production reminder: set this to your live frontend domain(s).
# Example: VITE_ALLOWED_HOSTS=prime7erp.com,www.prime7erp.com
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (optional, for sessions/cache)
REDIS_URL=redis://localhost:6379/0
# Per-tenant API cap (Redis), keyed on the tenant inside the signed access token (not the X-Tenant-Id header).
# GET /auth/me and /api/v1/admin are exempt. 0 = disable.
# TENANT_RATE_LIMIT_REQUESTS_PER_MINUTE=2000
# Requests without a valid token, per client IP (login pages, sign-up, webhooks). 0 = disable.
# ANON_RATE_LIMIT_REQUESTS_PER_MINUTE=300
#
# docker-compose.prod.yml only:
# BACKEND_BIND_ADDR=127.0.0.1   # publish port 8000 on localhost only when host Nginx proxies to it (default 0.0.0.0)
# OLLAMA_IMAGE_TAG=latest       # pin a tested Ollama version
# WATCHTOWER_LABEL_ENABLE=true  # false = old behaviour (auto-update every unlabelled container)

# App
API_V1_PREFIX=/api/v1
# APP_ENV=development
# Business "today" (default voucher / payroll / leave dates) when a tenant has no timezone of its own.
# APP_TIMEZONE=Asia/Dhaka
# Reuse fetched live currency rates for this many seconds (Redis when available). 0 = fetch on every lookup.
# FX_RATE_CACHE_SECONDS=3600

# Quotation read-only costing intelligence Phase 1 (deterministic). false = global kill-switch for POST /quotations/ai/cost-* routes.
# QUOTATION_AI_COSTING_PHASE1_ENABLED=true
# Quotation costing AI Phase 2 (line suggestions + guarded apply). Requires Phase 1 enabled.
# QUOTATION_AI_COSTING_PHASE2_ENABLED=false
# Quotation cost benchmark (Phase 13 advisory vs tenant history).
# QUOTATION_AI_COST_BENCHMARK_ENABLED=false

# ERP AI Phases 14–20 (global kill-switches; optional per-tenant overrides via tenants.feature_flags)
# PRODUCTION_PLANNING_AI_ENHANCED_ENABLED=false
# TNA_FOLLOWUP_AI_ENABLED=false
# DOCUMENT_AI_VALIDATION_ENABLED=false
# FINANCE_AI_READONLY_ENABLED=false
# EXECUTIVE_AI_DASHBOARD_ENABLED=false
# AI_COPILOT_READONLY_ENABLED=false
# AI_CONTROLLED_AUTOMATION_ENABLED=false

# Standard AI stack for both development and production:
# - MCP enabled
# - Ollama enabled as the default local LLM
# - Gemini enabled when GEMINI_API_KEY is set
# - vLLM optional and off by default unless you add a vllm service
#
# Tier-1 AI is local-first: Ollama when OLLAMA_URL is set, then OpenRouter if OPENROUTER_API_KEY is set. See docs/OPENROUTER.md and docs/OLLAMA_GEMMA.md.
# OPENROUTER_ENABLED=true
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Paid / fewer 429s (needs OpenRouter credits — confirm slug on openrouter.ai/models):
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=openai/gpt-4o
# Other presets (one at a time): docs/OPENROUTER.md and backend/app/common/openrouter_model_presets.py
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=google/gemma-3-12b-it:free
# OPENROUTER_MODEL=google/gemma-3-4b-it:free
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL=x-ai/grok-4.1-fast
# Prefer Docker Ollama before OpenRouter for tier-1 when both exist (default is OpenRouter first):
# OPENROUTER_TIER1_PREFERRED=false
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=P7 ERP
# OpenRouter-first for tier-1 chat / structured JSON AI when key + model are set (default: true).
# OPENROUTER_TIER1_PREFERRED=true
# Route tenant text features (dashboard brief, weekly report, planning narrative, etc.) through OpenRouter first; falls back to Gemini if enabled.
# OPENROUTER_TENANT_TEXT_ENABLED=true
#
# Google Gemini (optional): off by default. Set GEMINI_ENABLED=true and GEMINI_API_KEY for legacy Gemini features.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENABLED=false
# Optional: cap total Gemini calls per calendar month (0 = unlimited). Used by ai_tool + shared helpers.
# AI_MONTHLY_BUDGET_LIMIT=0
#
# Per-tenant daily cap for AI chat + approve-escalation (UTC day). 0 = unlimited.
# AI_MAX_REQUESTS_PER_TENANT_PER_DAY=0
# Max tokens for OpenRouter / paid OpenAI-compatible completions (MCP loop).
# AI_MAX_TOKENS_PER_REQUEST=4096

# Tier 1 local AI (Ollama — same Docker network as backend)
# OLLAMA_ENABLED=true
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=gemma2:2b-instruct-q4_K_M
# If Ollama runs on the host (Windows/macOS) and backend is in Docker, use:
# OLLAMA_URL=http://host.docker.internal:11434

# Optional vLLM override (off by default; enable only if you deploy a vllm service)
# VLLM_ENABLED=false
# VLLM_URL=http://vllm:8000
# VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_MAX_TOKENS=1024

# Tier 2 paid AI (only after user approval)
# PAID_LLM_PROVIDER=openrouter
# PAID_LLM_API_KEY=
# PAID_LLM_MODEL=
# PAID_LLM_BASE_URL=

# MCP server (docker compose enables this by default in development and production)
# MCP_ENABLED=true
# MCP_REQUIRE_AUTH=true          # Require JWT + tenant binding on /mcp (default true; set false only for unauthenticated local demos)
# MCP commit safety (recommended for both dev and prod: keep bypass false and set a secret)
# MCP_COMMIT_BYPASS=false
# MCP_HUMAN_APPROVAL_SECRET=<generate-a-strong-random-secret>

# Docker Compose: copy this file to `.env` in the repo root (same folder as docker-compose.yml) so
# `GEMINI_API_KEY` is injected into the backend container. backend/.env is only used when running
# uvicorn locally outside Docker.

# Load testing (docker compose -f docker-compose.yml -f docker-compose.loadtest.yml)
# Set these to a real tenant company_code and user credentials, or Locust login will fail.
# LOADTEST_COMPANY_CODE=DEMO
# LOADTEST_USERNAME=admin
# LOADTEST_PASSWORD=admin123
# Optional: multiple users (JSON array). Overrides username/password above.
# LOADTEST_USERS_JSON=[{"username":"admin","password":"secret"},{"username":"user2","password":"x"}]
# Employee id used by Locust for POST /hr/attendance/entries (must exist for your tenant).
# LOADTEST_EMPLOYEE_ID=1

# --- Lemon Squeezy (Merchant of Record) — injected into backend via docker-compose.yml ---
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_API_BASE_URL=https://api.lemonsqueezy.com
# LEMONSQUEEZY_CHECKOUT_SUCCESS_URL=http://localhost:5173/app/settings?ls_success=1
