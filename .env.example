# Database
DATABASE_URL=postgresql://p7erp:p7erp@localhost:5432/p7erp
# Optional SQLAlchemy pool tuning (async engine; see backend/app/database.py)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800

# API / DB performance observability (defaults off; see docs/PERF_ROLLBACK_RUNBOOK.md)
# PERF_TIMING_ENABLED=false
# PERF_TIMING_SLOW_MS=750
# PERF_POOL_METRICS_ENABLED=false
# PERF_REQUEST_QUERY_WARN_BYTES=8192
# PERF_SESSION_STATEMENT_TIMEOUT_MS=0
# PERF_SESSION_LOCK_TIMEOUT_MS=0

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Frontend base URL used in password reset emails.
FRONTEND_URL=https://prime7erp.com
# SMTP mail provider (Postmark SMTP example)
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=no-reply@prime7erp.com
# EMAILS_FROM_NAME=Prime7 ERP
# First-user bootstrap (tenant has zero users): use one of:
# - BOOTSTRAP_REGISTRATION_KEY — same value in X-Bootstrap-Key header or signup "Invitation code" (shared across tenants)
# - Per-tenant: set tenants.bootstrap_token_hash to bcrypt hash of a one-time secret (see docs/PRE_PRODUCTION_AUDIT.md Finding #4); cleared after first admin registers
# In production (APP_ENV not dev/local/test), you must set one of the above unless you intentionally use dev-only frictionless sign-up.
# BOOTSTRAP_REGISTRATION_KEY=

# Tenant: subdomain | header | path
TENANT_STRATEGY=header

# CORS (comma-separated origins, or leave empty to allow same-origin only)
# Production reminder: set CORS_ORIGINS to your live https:// domain(s).
CORS_ORIGINS=

# Frontend API base URL (Vite injects at build time). Leave unset or empty so the browser calls
# same-origin /api/* (Docker nginx on 5173/5174 proxies to backend; `npm run dev` uses Vite proxy).
# Set only for split-host deployments, e.g. VITE_API_BASE_URL=https://api.prime7erp.com
#VITE_API_BASE_URL=
#
# Production image tags for `docker-compose.prod.yml` (Docker Hub).
# Example branch build:
# BACKEND_IMAGE=your-dockerhub-user/p7erp-backend:main
# FRONTEND_IMAGE=your-dockerhub-user/p7erp-frontend:main
# Example release tag build:
# BACKEND_IMAGE=your-dockerhub-user/p7erp-backend:v1.0.0
# FRONTEND_IMAGE=your-dockerhub-user/p7erp-frontend:v1.0.0
#
# Frontend host allowlist for Vite (comma-separated, no spaces).
# Production reminder: set this to your live frontend domain(s).
# Example: VITE_ALLOWED_HOSTS=prime7erp.com,www.prime7erp.com
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (optional, for sessions/cache)
REDIS_URL=redis://localhost:6379/0
# Per-tenant API cap (Redis). All /api/v1 routes with X-Tenant-Id count except GET /auth/me. 0 = disable.
# TENANT_RATE_LIMIT_REQUESTS_PER_MINUTE=2000

# App
API_V1_PREFIX=/api/v1
# APP_ENV=development

# Quotation read-only costing intelligence Phase 1 (deterministic). false = global kill-switch for POST /quotations/ai/cost-* routes.
# QUOTATION_AI_COSTING_PHASE1_ENABLED=true
# Quotation costing AI Phase 2 (line suggestions + guarded apply). Requires Phase 1 enabled.
# QUOTATION_AI_COSTING_PHASE2_ENABLED=false
# Quotation cost benchmark (Phase 13 advisory vs tenant history).
# QUOTATION_AI_COST_BENCHMARK_ENABLED=false

# ERP AI Phases 14–20 (global kill-switches; optional per-tenant overrides via tenants.feature_flags)
# PRODUCTION_PLANNING_AI_ENHANCED_ENABLED=false
# TNA_FOLLOWUP_AI_ENABLED=false
# DOCUMENT_AI_VALIDATION_ENABLED=false
# FINANCE_AI_READONLY_ENABLED=false
# EXECUTIVE_AI_DASHBOARD_ENABLED=false
# AI_COPILOT_READONLY_ENABLED=false
# AI_CONTROLLED_AUTOMATION_ENABLED=false

# Standard AI stack for both development and production:
# - MCP enabled
# - Ollama enabled as the default local LLM
# - Gemini enabled when GEMINI_API_KEY is set
# - vLLM optional and off by default unless you add a vllm service
#
# Tier-1 AI is local-first: Ollama when OLLAMA_URL is set, then OpenRouter if OPENROUTER_API_KEY is set. See docs/OPENROUTER.md and docs/OLLAMA_GEMMA.md.
# OPENROUTER_ENABLED=true
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Paid / fewer 429s (needs OpenRouter credits — confirm slug on openrouter.ai/models):
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=openai/gpt-4o
# Other presets (one at a time): docs/OPENROUTER.md and backend/app/common/openrouter_model_presets.py
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=google/gemma-3-12b-it:free
# OPENROUTER_MODEL=google/gemma-3-4b-it:free
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL=x-ai/grok-4.1-fast
# Prefer Docker Ollama before OpenRouter for tier-1 when both exist:
# OPENROUTER_TIER1_PREFERRED=false
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=P7 ERP
# Use OpenRouter before local Ollama for tier-1 chat / structured JSON AI when both are configured.
# OPENROUTER_TIER1_PREFERRED=false
# Route tenant text features (dashboard brief, weekly report, planning narrative, etc.) through OpenRouter first; falls back to Gemini if enabled.
# OPENROUTER_TENANT_TEXT_ENABLED=false
#
# Google Gemini (optional): off by default. Set GEMINI_ENABLED=true and GEMINI_API_KEY for legacy Gemini features.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENABLED=false
# Optional: cap total Gemini calls per calendar month (0 = unlimited). Used by ai_tool + shared helpers.
# AI_MONTHLY_BUDGET_LIMIT=0
#
# Per-tenant daily cap for AI chat + approve-escalation (UTC day). 0 = unlimited.
# AI_MAX_REQUESTS_PER_TENANT_PER_DAY=0
# Max tokens for OpenRouter / paid OpenAI-compatible completions (MCP loop).
# AI_MAX_TOKENS_PER_REQUEST=4096

# Tier 1 local AI (Ollama — same Docker network as backend)
# OLLAMA_ENABLED=true
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=gemma2:2b-instruct-q4_K_M
# If Ollama runs on the host (Windows/macOS) and backend is in Docker, use:
# OLLAMA_URL=http://host.docker.internal:11434

# Optional vLLM override (off by default; enable only if you deploy a vllm service)
# VLLM_ENABLED=false
# VLLM_URL=http://vllm:8000
# VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_MAX_TOKENS=1024

# Tier 2 paid AI (only after user approval)
# PAID_LLM_PROVIDER=openrouter
# PAID_LLM_API_KEY=
# PAID_LLM_MODEL=
# PAID_LLM_BASE_URL=

# MCP server (docker compose enables this by default in development and production)
# MCP_ENABLED=true
# MCP_REQUIRE_AUTH=true          # Require JWT + tenant binding on /mcp (default true; set false only for unauthenticated local demos)
# MCP commit safety (recommended for both dev and prod: keep bypass false and set a secret)
# MCP_COMMIT_BYPASS=false
# MCP_HUMAN_APPROVAL_SECRET=<generate-a-strong-random-secret>

# Docker Compose: copy this file to `.env` in the repo root (same folder as docker-compose.yml) so
# `GEMINI_API_KEY` is injected into the backend container. backend/.env is only used when running
# uvicorn locally outside Docker.

# Load testing (docker compose -f docker-compose.yml -f docker-compose.loadtest.yml)
# Set these to a real tenant company_code and user credentials, or Locust login will fail.
# LOADTEST_COMPANY_CODE=DEMO
# LOADTEST_USERNAME=admin
# LOADTEST_PASSWORD=admin123
# Optional: multiple users (JSON array). Overrides username/password above.
# LOADTEST_USERS_JSON=[{"username":"admin","password":"secret"},{"username":"user2","password":"x"}]
# Employee id used by Locust for POST /hr/attendance/entries (must exist for your tenant).
# LOADTEST_EMPLOYEE_ID=1

# --- Lemon Squeezy (Merchant of Record) — injected into backend via docker-compose.yml ---
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_API_BASE_URL=https://api.lemonsqueezy.com
# LEMONSQUEEZY_CHECKOUT_SUCCESS_URL=http://localhost:5173/app/settings?ls_success=1
