# Smaller build context; faster uploads and fewer irrelevant COPY invalidations
.git
.gitignore
__pycache__
*.py[cod]
*$py.class
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
.env
.env.*
*.md
tests
# Runtime data must never be baked into images (tenant uploads, database dumps, debug logs)
media
backups
*.log
