# Backend env (copy to .env and configure)

# Database
DATABASE_URL=postgresql://p7erp:p7erp@localhost:5432/p7erp

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Tenant: subdomain | header | path
TENANT_STRATEGY=header

# CORS (comma-separated origins, or leave empty to allow same-origin only)
# Production reminder: set CORS_ORIGINS to your live https:// domain(s).
CORS_ORIGINS=

# Frontend API URL reminder: in production, set VITE_API_BASE_URL to your live https:// API domain.
# Example: VITE_API_BASE_URL=https://api.prime7erp.com
#
# Frontend host allowlist for Vite (comma-separated, no spaces).
# Production reminder: set this to your live frontend domain(s).
# Example: VITE_ALLOWED_HOSTS=prime7erp.com,www.prime7erp.com
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (optional, for sessions/cache)
REDIS_URL=redis://localhost:6379/0

# App
API_V1_PREFIX=/api/v1
# APP_ENV=development

# Quotation costing intelligence Phase 1 (read-only). false = global kill-switch for POST /quotations/ai/cost-* .
# QUOTATION_AI_COSTING_PHASE1_ENABLED=true
# Phase 2: line costing suggestions + guarded apply (requires Phase 1).
# QUOTATION_AI_COSTING_PHASE2_ENABLED=false
# Phase 13: advisory cost benchmark vs tenant history.
# QUOTATION_AI_COST_BENCHMARK_ENABLED=false

# Phases 14–20 (see root .env.example for descriptions)
# PRODUCTION_PLANNING_AI_ENHANCED_ENABLED=false
# TNA_FOLLOWUP_AI_ENABLED=false
# DOCUMENT_AI_VALIDATION_ENABLED=false
# FINANCE_AI_READONLY_ENABLED=false
# EXECUTIVE_AI_DASHBOARD_ENABLED=false
# AI_COPILOT_READONLY_ENABLED=false
# AI_CONTROLLED_AUTOMATION_ENABLED=false

# Standard AI stack for both development and production:
# - MCP enabled
# - Ollama enabled as the default local LLM
# - Gemini enabled when GEMINI_API_KEY is set
# - vLLM optional and off by default unless you add a vllm service
#
# Tier 1 local AI (for local non-Docker runs, use localhost)
# OLLAMA_ENABLED=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Tier 2 paid AI (only after user approval)
# PAID_LLM_PROVIDER=openai
# PAID_LLM_API_KEY=
# PAID_LLM_MODEL=gpt-4o

# MCP server mounted in backend process (docker compose enables this by default in development and production)
# MCP_ENABLED=true
# MCP_REQUIRE_AUTH=true          # Require JWT + tenant binding on /mcp (default true; set false only for unauthenticated local demos)

# MCP commit safety (recommended for both dev and prod: keep bypass false and set a secret)
# MCP_COMMIT_BYPASS=false
# MCP_HUMAN_APPROVAL_SECRET=<generate-a-strong-random-secret>

# Optional vLLM override (off by default; enable only if you deploy a vllm service)
# VLLM_ENABLED=false
# VLLM_URL=http://vllm:8000
# VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_MAX_TOKENS=1024

# Celery (defaults broker/backend to REDIS_URL when empty)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# FORECAST_MAX_CONCURRENT=2
# ANALYSIS_MAX_CONCURRENT=4
# MCP sync forecast path limits (generate_forecast tool)
# FORECAST_SYNC_MAX_HORIZON_DAYS=90
# FORECAST_SYNC_TIMEOUT_SECONDS=30
