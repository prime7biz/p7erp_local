# Frontend env (copy to .env and configure)
# Production reminder: set VITE_API_BASE_URL to your live https:// API domain (no trailing slash).
# Used by frontend/src/api/client.ts
VITE_API_BASE_URL=http://localhost:8000

# Must match backend API_V1_PREFIX (default /api/v1). Used by secure tenant image URLs.
# VITE_API_V1_PREFIX=/api/v1

# Frontend host allowlist for Vite dev server (comma-separated, no spaces).
# Production/staging reminder: set live domain(s), e.g. prime7erp.com,www.prime7erp.com
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: default Lemon Squeezy variant ID on Settings overview (checkout). Map variants to plans in platform admin.
# VITE_LEMONSQUEEZY_CHECKOUT_VARIANT_ID=
