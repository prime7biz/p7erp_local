  "videos": [
    {
      "name": "settings-invite-user",
      "title": "Invite a new staff user",
      "steps": [
        { "goto": "/app/settings/users" },
        { "caption": "Goal: give a new colleague their own login. Open Settings → User Mgmt.", "ms": 3200 },
        { "hover": "table thead" },
        { "caption": "The table lists every user, their role and whether they are active.", "ms": 2800 },
        { "click": "role=button[name=\"Invite staff\"]" },
        { "caption": "Invite staff emails a secure link. The person sets their own password.", "ms": 3000 },
        { "fill": ["role=dialog >> input[type=\"email\"]", "store.keeper@lakhsma-demo.com"] },
        { "fill": ["role=dialog >> input[placeholder=\"First name\"]", "Rahim"] },
        { "fill": ["role=dialog >> input[placeholder=\"Last name\"]", "Uddin"] },
        { "hover": "role=dialog >> select" },
        { "caption": "Pick the Role. The role decides which menus and buttons this person can use.", "ms": 3400 },
        { "hover": "role=dialog >> role=button[name=\"Send invite\"]" },
        { "caption": "Click Send invite to finish. (This demo closes without sending.)", "ms": 3200 },
        { "click": "role=dialog >> role=button[name=\"Close\"]" },
        { "scroll": 1200 },
        { "caption": "Sent invites wait under Pending invitations. Use Resend or Cancel there.", "ms": 3400 }
      ]
    },
    {
      "name": "settings-roles-tour",
      "title": "Create a role and choose permissions",
      "steps": [
        { "goto": "/app/settings/roles" },
        { "caption": "Goal: make a role for store keepers. Open Settings → Roles.", "ms": 3000 },
        { "fill": ["input[placeholder=\"System name (e.g. merch_manager) **\"]", "store_keeper"] },
        { "fill": ["input[placeholder=\"Display name **\"]", "Store keeper"] },
        { "caption": "System name is a short code (no spaces). Display name is what people see.", "ms": 3200 },
        { "select": ["select:has(option[value=\"data_entry\"])", "data_entry"] },
        { "caption": "A template ticks many boxes at once. Data entry = read + write everywhere.", "ms": 3400 },
        { "hover": "table thead" },
        { "caption": "Access turns a whole module on or off. Read, Write, Edit, Approve and Export are finer levels.", "ms": 3800 },
        { "scroll": 700 },
        { "caption": "Untick modules this person must not see, for example Finance or HR.", "ms": 3000 },
        { "hover": "text=Material control & finance governance" },
        { "caption": "Governance switches give extra powers (e.g. over-receipt approval). Admin and manager roles always have them.", "ms": 4200 },
        { "hover": "role=button[name=\"Create role\"]" },
        { "caption": "Click Create role to finish. Then assign it to users in User Mgmt. (Not saved in this demo.)", "ms": 3600 }
      ]
    },
    {
      "name": "ai-assistant-drawer-tour",
      "title": "Open the AI assistant and see what it knows",
      "steps": [
        { "goto": "/app/orders", "waitMs": 3000 },
        { "caption": "Goal: ask the AI about the record you are looking at. First open an order.", "ms": 3200 },
        { "click": "table tbody tr >> nth=0 >> a[href^=\"/app/orders/\"]", "timeout": 45000, "waitMs": 2500 },
        { "caption": "Now click the ✦ sparkle button in the top bar.", "ms": 2600 },
        { "click": "button[title=\"Prime7 AI\"]", "waitMs": 2500 },
        { "caption": "The chip 'Asking about …' means your question will use this order.", "ms": 3600 },
        { "hover": "input[placeholder^=\"Ask about dashboard\"]" },
        { "caption": "Type a question such as 'When is this order due?' and press Send.", "ms": 3200 },
        { "caption": "The AI only reads records your role can open. It never saves or approves anything by itself.", "ms": 4000 },
        { "caption": "If it needs paid cloud processing, it asks first: Approve Paid Processing or Cancel.", "ms": 3800 },
        { "click": "button[title=\"New AI session\"] + button[title=\"Close\"]" },
        { "goto": "/app/ai/agents" },
        { "caption": "AI Tools → Exception agents lists problems found by rules: late TNA, expiring LCs, BOM gaps.", "ms": 3800 },
        { "click": "role=button[name=\"Actions\"] >> nth=0" },
        { "caption": "Actions → Notify… prepares a message. A manager must click Confirm & send.", "ms": 3600 },
        { "press": "Escape" },
        { "caption": "Nothing is sent until a person confirms. Every decision is written to the audit log.", "ms": 3400 }
      ]
    }
  ]
}
