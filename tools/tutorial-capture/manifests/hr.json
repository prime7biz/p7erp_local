  "videos": [
    {
      "name": "hr-add-employee",
      "title": "Add a new employee",
      "steps": [
        { "goto": "/app/hr/employees" },
        { "caption": "Goal: add a new worker to the employee master. Open HR → Employees.", "ms": 3200 },
        { "hover": "input[placeholder=\"Search code, name, email or phone\"]" },
        { "caption": "Search first by code or name, so you do not create the same person twice.", "ms": 2800 },
        { "click": "role=button[name=\"+ Add employee\"] >> nth=0" },
        { "caption": "First name is required. The employee number is given automatically when you save.", "ms": 3200 },
        { "fill": ["input[placeholder=\"First name\"]", "Rahima"] },
        { "fill": ["input[placeholder=\"Last name\"]", "Akter"] },
        { "fill": ["input[placeholder=\"Mobile (e.g. 01712345678)\"]", "01711000201"] },
        { "select": ["form select:has(option:text-is(\"No department\"))", { "label": "D-PROD - Production" }] },
        { "caption": "Pick the Department, then the Designation. Set the joining date at the bottom.", "ms": 3000 },
        { "hover": "form label:has-text(\"Linked app user\") select" },
        { "caption": "Linked app user: choose the person's login so they can use My Leave, My Attendance and My Payslips.", "ms": 3600 },
        { "hover": "form button[type=\"submit\"]" },
        { "caption": "Check everything, then click Save to finish. (This demo cancels instead.)", "ms": 3000 },
        { "click": "form >> role=button[name=\"Cancel\"]" },
        { "caption": "After saving, open Actions → View to fill Personal, Job and Documents tabs.", "ms": 3200 }
      ]
    },
    {
      "name": "hr-leave-application",
      "title": "Enter a leave application and find it for approval",
      "steps": [
        { "goto": "/app/hr/leave?tab=requests" },
        { "caption": "Goal: record a leave application for a worker. Open HR → Leave; the Requests tab opens first.", "ms": 3200 },
        { "click": "role=button[name=\"+ Add leave request\"] >> nth=0", "waitMs": 800 },
        { "caption": "The form opens in a panel on the right. Fields marked ** are mandatory.", "ms": 3000 },
        { "hover": "#hr-crud-employee_id" },
        { "caption": "Employee: type part of the code or name and pick the person from the list.", "ms": 3200 },
        { "select": ["#hr-crud-leave_type_id", { "index": 1 }] },
        { "fill": ["#hr-crud-from_date", "2026-11-20"] },
        { "fill": ["#hr-crud-to_date", "2026-11-21"] },
        { "caption": "Choose the Leave type, then pick the From and To dates.", "ms": 2600 },
        { "fill": ["#hr-crud-days_requested", "2"] },
        { "fill": ["#hr-crud-reason", "Family wedding"] },
        { "hover": "role=dialog >> role=button[name=\"Save\"]" },
        { "caption": "Click Save to send the request. Days are reserved from the balance straight away. (Not saved in this demo.)", "ms": 3800 },
        { "goto": "/app/hr/leave?tab=approvals" },
        { "caption": "A manager opens the Approvals tab. Pending requests appear here with the employee's name.", "ms": 3200 },
        { "caption": "Click the green Approve button or Reject on each row. Approval moves the days from Pending to Used.", "ms": 3800 }
      ]
    },
    {
      "name": "hr-attendance-tour",
      "title": "Tour of time & attendance screens",
      "steps": [
        { "goto": "/app/hr/attendance-setup?tab=shifts" },
        { "caption": "Goal: see how attendance is set up and entered. HR → Attendance Setup → Shifts hold start and end times.", "ms": 3400 },
        { "goto": "/app/hr/attendance-setup?tab=holidays" },
        { "caption": "Holidays tab — add plant-wide holidays once a year.", "ms": 3000 },
        { "goto": "/app/hr/attendance-setup?tab=roster" },
        { "caption": "Roster tab — put a worker on a shift for a day, or mark a week off.", "ms": 3200 },
        { "goto": "/app/hr/attendance?tab=entries" },
        { "caption": "Daily work: HR → Attendance → Daily entry. Type a missed punch, or upload a biometric batch.", "ms": 3400 },
        { "click": "role=button[name=\"+ Add entry\"] >> nth=0", "waitMs": 800 },
        { "fill": ["#att-in", "08:02:00"] },
        { "fill": ["#att-out", "17:05:00"] },
        { "hover": "role=dialog >> role=button[name=\"Save\"]" },
        { "caption": "Search the employee, pick the date, check the Status, then click Save. (Not saved in this demo.)", "ms": 3600 },
        { "click": "role=dialog >> role=button[name=\"Cancel\"]", "waitMs": 600 },
        { "goto": "/app/hr/attendance?tab=regularizations" },
        { "caption": "Regularizations tab — managers approve or reject punch-time corrections with one click.", "ms": 3200 },
        { "goto": "/app/hr/attendance?tab=summary" },
        { "caption": "Summary tab — present, absent, late and leave days per employee. Payroll uses these numbers.", "ms": 3800 }
