  "videos": [
    {
      "name": "hr-add-employee",
      "title": "Add a new employee",
      "steps": [
        { "goto": "/app/hr/employees" },
        { "caption": "Goal: add a new worker to the employee master. Open HR → Core HR → Employees.", "ms": 3200 },
        { "hover": "input[placeholder=\"Search by code/name\"]" },
        { "caption": "Search first by code or name, so you do not create the same person twice.", "ms": 2800 },
        { "click": "role=button[name=\"Add employee\"]" },
        { "caption": "Employee code and First name are required. Use your factory ID card number as the code.", "ms": 3200 },
        { "fill": ["input[placeholder=\"Employee code\"]", "EMP-0201"] },
        { "fill": ["input[placeholder=\"First name\"]", "Rahima"] },
        { "fill": ["input[placeholder=\"Last name\"]", "Akter"] },
        { "fill": ["input[placeholder=\"Phone\"]", "01711000201"] },
        { "select": ["form select >> nth=0", { "label": "D-PROD - Production" }] },
        { "caption": "Pick the Department, then the Designation. Set the joining date at the bottom.", "ms": 3000 },
        { "hover": "form label:has-text(\"Linked app user\") select" },
        { "caption": "Linked app user: choose the person's login so they can use My Leave, My Attendance and My Payslips.", "ms": 3600 },
        { "hover": "form button[type=\"submit\"]" },
        { "caption": "Check everything, then click Save to finish. (This demo cancels instead.)", "ms": 3000 },
        { "click": "form >> role=button[name=\"Cancel\"]" },
        { "caption": "After saving, open Actions → View to fill Personal, Job and Documents tabs.", "ms": 3200 }
      ]
    },
    {
      "name": "hr-leave-application",
      "title": "Enter a leave application and find it for approval",
      "steps": [
        { "goto": "/app/hr/leave/requests" },
        { "caption": "Goal: record a leave application for a worker. Open HR → Leave → Requests.", "ms": 3200 },
        { "scroll": 900 },
        { "caption": "The Add leave request form is below the list. Fields marked ** are mandatory.", "ms": 3000 },
        { "fill": ["label:has-text(\"Employee ID\") input", "1"] },
        { "fill": ["label:has-text(\"Leave Type ID\") input", "1"] },
        { "hover": "label:has-text(\"From Date\") input" },
        { "caption": "Pick the From Date and To Date from the calendar.", "ms": 2600 },
        { "fill": ["label:has-text(\"Days requested\") input", "2"] },
        { "fill": ["label:has-text(\"Reason\") input", "Family wedding"] },
        { "hover": "form button[type=\"submit\"]" },
        { "caption": "Click Save to send the request. Days are reserved from the balance straight away. (Not saved in this demo.)", "ms": 3800 },
        { "goto": "/app/hr/leave/approvals" },
        { "caption": "A manager opens HR → Leave → Approvals. Pending requests appear here.", "ms": 3200 },
        { "caption": "Use Actions → Approve or Reject on each row. Approval moves the days from Pending to Used.", "ms": 3800 }
      ]
    },
    {
      "name": "hr-attendance-tour",
      "title": "Tour of time & attendance screens",
      "steps": [
        { "goto": "/app/hr/attendance/shifts" },
        { "caption": "Goal: see how attendance is set up and entered. Step 1: Shifts hold start and end times.", "ms": 3400 },
        { "goto": "/app/hr/attendance/holidays" },
        { "caption": "Step 2: Holidays — add plant-wide holidays once a year.", "ms": 3000 },
        { "goto": "/app/hr/attendance/roster" },
        { "caption": "Step 3: Roster — put a worker on a shift for a day, or mark a week off.", "ms": 3200 },
        { "goto": "/app/hr/attendance/entries" },
        { "caption": "Step 4: Daily Entry — type a missed punch, or upload a biometric batch below.", "ms": 3400 },
        { "fill": ["input[placeholder=\"Employee ID\"]", "1"] },
        { "fill": ["input[placeholder=\"In time (HH:MM:SS)\"]", "08:02:00"] },
        { "fill": ["input[placeholder=\"Out time (HH:MM:SS)\"]", "17:05:00"] },
        { "hover": "role=button[name=\"Save entry\"]" },
        { "caption": "Pick the date, check the Status, then click Save entry to finish. (Not saved in this demo.)", "ms": 3600 },
        { "goto": "/app/hr/attendance/regularizations" },
        { "caption": "Step 5: Regularizations — managers approve or reject punch-time corrections.", "ms": 3200 },
        { "goto": "/app/hr/attendance/summary" },
        { "caption": "Step 6: Summary — present, absent, late and leave days per employee. Payroll uses these numbers.", "ms": 3800 }
