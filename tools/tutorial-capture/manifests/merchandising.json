  "videos": [
    {
      "name": "merch-inquiry-to-quotation",
      "title": "From inquiry to quotation",
      "steps": [
        { "goto": "/app/inquiries", "waitMs": 3000 },
        { "caption": "Goal: turn a buyer inquiry into a priced quotation", "ms": 3000 },
        { "caption": "Merchandising > Inquiries lists every buyer request. Colour shows the status.", "ms": 3000 },
        { "click": "main a:has-text(\"INQ-0014\")", "waitMs": 2500 },
        { "caption": "This inquiry is Submitted, so the page offers Convert to quotation", "ms": 3200 },
        { "hover": "main button:has-text(\"Convert to quotation\")", "waitMs": 600 },
        { "caption": "Convert to quotation copies customer, style, quantity and price into a new Draft quotation", "ms": 3600 },
        { "caption": "We will not click it in this demo. You can also start a quotation from scratch.", "ms": 3000 },
        { "goto": "/app/quotations", "waitMs": 3000 },
        { "caption": "Merchandising > Quotations. Click New quotation.", "ms": 2600 },
        { "click": "main button:has-text(\"New quotation\")", "waitMs": 3000 },
        { "caption": "Pick the Customer first (fields marked ** are required)", "ms": 2800 },
        { "select": ["main select >> nth=0", { "label": "Pacific Apparel Incorporated (LKH-CUST-02)" }], "waitMs": 1500 },
        { "hover": "main select >> nth=1", "waitMs": 600 },
        { "caption": "Link to inquiry (optional) lets you pick an open inquiry for the same buyer", "ms": 3200 },
        { "scroll": 900, "waitMs": 1000 },
        { "caption": "Below, add Materials, Labor / CM and Other costs. Totals and FOB update as you type.", "ms": 3600 },
        { "caption": "Click Save draft to finish, then Submit for review. Nothing is saved in this demo.", "ms": 3600 }
      ]
    },
    {
      "name": "merch-order-bom",
      "title": "Open an order and its BOM",
      "steps": [
        { "goto": "/app/orders", "waitMs": 3000 },
        { "caption": "Goal: check an order and open its order BOM (bill of materials)", "ms": 3000 },
        { "click": "main a:has-text(\"ORD-0007\")", "waitMs": 3500 },
        { "hover": "div.rounded-xl:has(> div > div > span:text-is(\"Order pipeline\"))", "waitMs": 500 },
        { "caption": "Order pipeline shows the current stage. Next required action tells you what to do now.", "ms": 3800 },
        { "hover": "section[aria-labelledby=\"csm-title\"]", "waitMs": 500 },
        { "caption": "Colour / size breakdown holds pieces per colour and size", "ms": 3000 },
        { "hover": "section:has(> h2:text-is(\"Related Records\"))", "waitMs": 500 },
        { "caption": "Related Records links every document of this order: BOM, POs, TNA, challans, invoices", "ms": 3600 },
        { "click": "main a:has-text(\"View BOM\")", "waitMs": 3500 },
        { "caption": "BOM Builder opens for this order. The badge on the right shows the BOM status.", "ms": 3400 },
        { "caption": "Buttons follow the status: Submit, then Approve or Reject, then Freeze", "ms": 3400 },
        { "scroll": 650, "waitMs": 1000 },
        { "caption": "Each line shows consumption, wastage %, required quantity, price and PO status", "ms": 3600 },
        { "caption": "Use Actions on a line to edit it (Draft only) or create a PO (after approval). Nothing is changed in this demo.", "ms": 4000 }
      ]
    },
    {
      "name": "merch-tna-followup",
      "title": "Follow up TNA tasks",
      "steps": [
        { "goto": "/app/followup", "waitMs": 3500 },
        { "caption": "Goal: see which TNA (time and action) tasks are due or late", "ms": 3000 },
        { "hover": "main div.grid >> nth=0", "waitMs": 500 },
        { "caption": "The cards count Open, Overdue, Due this week and Rejected tasks", "ms": 3200 },
        { "click": "main button:has-text(\"Generate TNA\")", "waitMs": 1000 },
        { "caption": "Generate TNA builds the task list for an order from templates. The order needs a delivery date.", "ms": 3800 },
        { "click": "div.fixed button:has-text(\"Cancel\")", "waitMs": 800 },
        { "select": ["main select >> nth=0", { "label": "ORD-0007" }], "waitMs": 1800 },
        { "caption": "Filter by order, buyer, person, status or phase to focus your list", "ms": 3200 },
        { "click": "#followup-table-print-area tbody tr >> nth=0 >> button:has-text(\"Actions\")", "waitMs": 900 },
        { "caption": "Actions: Mark submitted, Mark rejected, Edit dates, Complete or Reopen", "ms": 3600 },
        { "click": "#followup-table-print-area tbody tr >> nth=0 >> button:has-text(\"Actions\")", "waitMs": 600 },
        { "click": "main button:text-is(\"Calendar\")", "waitMs": 2500 },
        { "caption": "Calendar shows tasks on their planned dates", "ms": 3000 },
        { "click": "main button:text-is(\"Kanban\")", "waitMs": 2000 },
        { "caption": "Kanban groups tasks by phase. Click a card to edit it.", "ms": 3200 }
      ]
    }
  ]
